#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

source /common.sh
install_cleanup_trap
source /files/00-config

########################################
# Configuration                        #
########################################

MANIFEST_URL="https://crafter3d.github.io/printer-config/firmware/latest/manifest.json"
STAGE_DIR="/tmp/crafter3d-firmware"
MANIFEST_PATH="${STAGE_DIR}/manifest.json"
KLIPPER_REF_PATH="/tmp/crafter3d-klipper-ref"

warn_and_exit_success() {
    echo "WARNING: $1"
    echo "Falling back to configured KLIPPER_REF from /files/00-config"
    rm -f "${KLIPPER_REF_PATH}"
    rm -rf "${STAGE_DIR}"
    exit 0
}

########################################
# Install dependencies                 #
########################################

apt-get install --yes wget jq ca-certificates

########################################
# Fetch latest manifest                #
########################################

rm -f "${KLIPPER_REF_PATH}"
rm -rf "${STAGE_DIR}"
mkdir -p "${STAGE_DIR}"

if ! wget -qO "${MANIFEST_PATH}" "${MANIFEST_URL}"; then
    warn_and_exit_success "Unable to fetch firmware manifest from ${MANIFEST_URL}"
fi

if ! OCTOPUS_URL="$(jq -er '.latest.octopus_f446_usb_can.download_url' "${MANIFEST_PATH}")"; then
    warn_and_exit_success "Manifest missing latest.octopus_f446_usb_can.download_url"
fi

if ! OCTOPUS_SHA="$(jq -er '.latest.octopus_f446_usb_can.sha256' "${MANIFEST_PATH}")"; then
    warn_and_exit_success "Manifest missing latest.octopus_f446_usb_can.sha256"
fi

if ! EBB42_URL="$(jq -er '.latest.ebb42_g0b1_can.download_url' "${MANIFEST_PATH}")"; then
    warn_and_exit_success "Manifest missing latest.ebb42_g0b1_can.download_url"
fi

if ! EBB42_SHA="$(jq -er '.latest.ebb42_g0b1_can.sha256' "${MANIFEST_PATH}")"; then
    warn_and_exit_success "Manifest missing latest.ebb42_g0b1_can.sha256"
fi

if ! KLIPPER_REF_RAW="$(jq -er '.latest.octopus_f446_usb_can.klipper_ref' "${MANIFEST_PATH}")"; then
    warn_and_exit_success "Manifest missing latest.octopus_f446_usb_can.klipper_ref"
fi

KLIPPER_SHA="$(echo "${KLIPPER_REF_RAW}" | grep -oE '[0-9a-f]{7,40}' | head -n1 || true)"
if [[ ! "${KLIPPER_SHA}" =~ ^[0-9a-f]{7,40}$ ]]; then
    warn_and_exit_success "Could not parse Klipper SHA from klipper_ref: ${KLIPPER_REF_RAW}"
fi

printf '%s\n' "${KLIPPER_SHA}" > "${KLIPPER_REF_PATH}"

########################################
# Fetch firmware binaries              #
########################################

if ! wget -qO "${STAGE_DIR}/octopus-f446-usb-can.bin" "${OCTOPUS_URL}"; then
    warn_and_exit_success "Unable to download octopus_f446_usb_can binary"
fi

if ! wget -qO "${STAGE_DIR}/ebb42-g0b1-can.bin" "${EBB42_URL}"; then
    warn_and_exit_success "Unable to download ebb42_g0b1_can binary"
fi

if ! echo "${OCTOPUS_SHA}  ${STAGE_DIR}/octopus-f446-usb-can.bin" | sha256sum -c -; then
    warn_and_exit_success "Checksum validation failed for octopus-f446-usb-can.bin"
fi

if ! echo "${EBB42_SHA}  ${STAGE_DIR}/ebb42-g0b1-can.bin" | sha256sum -c -; then
    warn_and_exit_success "Checksum validation failed for ebb42-g0b1-can.bin"
fi

echo "Firmware manifest and binaries staged in ${STAGE_DIR}"
echo "Resolved firmware-matched Klipper ref: ${KLIPPER_SHA}"
