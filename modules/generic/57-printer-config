#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

REPO="https://github.com/crafter3d/printer-config.git"
TARGET_DIR="/home/${BASE_USER}/printer-config"

warn_missing_timelapse_include() {
    local config_dir printer_cfg managed_cfg include_regex
    config_dir="/home/${BASE_USER}/printer_data/config"
    printer_cfg="${config_dir}/printer.cfg"
    managed_cfg="${config_dir}/printer.managed.cfg"
    include_regex='^\[include[[:space:]]+timelapse\.cfg\]'

    if [[ -f "${printer_cfg}" ]] && grep -Eq "${include_regex}" "${printer_cfg}" 2>/dev/null; then
        return
    fi

    if [[ -f "${managed_cfg}" ]] && grep -Eq "${include_regex}" "${managed_cfg}" 2>/dev/null; then
        return
    fi

    echo "WARNING: Missing [include timelapse.cfg] in Klipper entrypoint."
    echo "WARNING: Add it to ${printer_cfg} or ${managed_cfg} for TIMELAPSE_TAKE_FRAME macro mode."
}

########################################
# Install dependencies                 #
########################################

apt-get install --yes git

########################################
# Clone printer-config repository      #
########################################

pushd "/home/${BASE_USER}" &> /dev/null || exit 1
if [[ ! -d "${TARGET_DIR}" ]]; then
    sudo -u "${BASE_USER}" git clone "${REPO}" "${TARGET_DIR}"
fi
popd &> /dev/null || exit 1

########################################
# Run install script to refresh copied  #
# config content in printer_data/config #
########################################

sudo -u "${BASE_USER}" \
    env HOME="/home/${BASE_USER}" \
    INSTALL_MODE=symlink \
    bash "${TARGET_DIR}/scripts/install.sh"

warn_missing_timelapse_include

########################################
# Install firmware build profiles      #
########################################

install -d -m 0755 /usr/share/crafter3d/firmware/profiles
cp "${TARGET_DIR}/firmware/profiles/"*.config /usr/share/crafter3d/firmware/profiles/

########################################
# Install staged firmware artifacts    #
########################################

STAGE_DIR="/tmp/crafter3d-firmware"
TARGET_FIRMWARE_DIR="/home/${BASE_USER}/printer_data/firmware"
FALLBACK_FIRMWARE_DIR="${TARGET_DIR}/firmware"

if [[ -f "${STAGE_DIR}/manifest.json" && -f "${STAGE_DIR}/octopus-f446-usb-can.bin" && -f "${STAGE_DIR}/ebb42-g0b1-can.bin" ]]; then
    install -d -m 0755 "${TARGET_FIRMWARE_DIR}"
    install -m 0644 "${STAGE_DIR}/manifest.json" "${TARGET_FIRMWARE_DIR}/manifest.json"
    install -m 0644 "${STAGE_DIR}/octopus-f446-usb-can.bin" "${TARGET_FIRMWARE_DIR}/octopus-f446-usb-can.bin"
    install -m 0644 "${STAGE_DIR}/ebb42-g0b1-can.bin" "${TARGET_FIRMWARE_DIR}/ebb42-g0b1-can.bin"
    chown -R "${BASE_USER}:${BASE_USER}" "${TARGET_FIRMWARE_DIR}"
    echo "Installed firmware artifacts from staged latest manifest"
else
    echo "WARNING: staged firmware artifacts missing in ${STAGE_DIR}; trying fallback firmware artifacts from ${FALLBACK_FIRMWARE_DIR}"
    install -d -m 0755 "${TARGET_FIRMWARE_DIR}"

    fallback_installed="no"

    if [[ -f "${FALLBACK_FIRMWARE_DIR}/manifest.json" ]]; then
        install -m 0644 "${FALLBACK_FIRMWARE_DIR}/manifest.json" "${TARGET_FIRMWARE_DIR}/manifest.json"
        fallback_installed="yes"
    fi

    for fw in octopus-f446-usb-can.bin ebb42-g0b1-can.bin; do
        if [[ -f "${FALLBACK_FIRMWARE_DIR}/${fw}" ]]; then
            install -m 0644 "${FALLBACK_FIRMWARE_DIR}/${fw}" "${TARGET_FIRMWARE_DIR}/${fw}"
            fallback_installed="yes"
        fi
    done

    if [[ "${fallback_installed}" == "yes" ]]; then
        chown -R "${BASE_USER}:${BASE_USER}" "${TARGET_FIRMWARE_DIR}"
        echo "Installed fallback firmware artifacts from printer-config repository"
    else
        echo "WARNING: no fallback firmware binaries found under ${FALLBACK_FIRMWARE_DIR}"
    fi
fi

# Ensure runtime config files and symlinks are consistently owned by BASE_USER.
chown -R "${BASE_USER}:${BASE_USER}" /home/"${BASE_USER}"/printer_data
