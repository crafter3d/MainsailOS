# shellcheck enable=require-variable-braces

## Error handling
set -Ee

# Debug
# set -x

## Set LC_ALL to prevent errors
export LC_ALL=C

# Colored Output
RED="\e[31m"
YEL="\e[33m"
GRE="\e[32m"
WHITE="\e[97m"
NOC="\e[0m"

### Setup
SERVICES=(moonraker klipper nginx sonar crowsnest)
SYSTEMD_DIR="/etc/systemd/system"
# Username baked into the image at build time; used as the source in rename operations
BUILD_USER="crafter3d"

detect_default_user() {
    local user_by_uid user_first_regular

    user_by_uid="$(awk -F ':' '$3 == 1000 { print $1; exit }' /etc/passwd)"
    if [[ -n "${user_by_uid}" ]]; then
        echo "${user_by_uid}"
        return
    fi

    user_first_regular="$(awk -F ':' '$3 >= 1000 && $1 != "nobody" { print $1; exit }' /etc/passwd)"
    if [[ -n "${user_first_regular}" ]]; then
        echo "${user_first_regular}"
        return
    fi

    echo "${BUILD_USER}"
}

DEFAULT_USER="$(detect_default_user)"

### KlipperScreen workaround
KS_INSTALLED="0"
if [[ -d "/home/${DEFAULT_USER}/KlipperScreen" ]] || [[ -d "/home/${BUILD_USER}/KlipperScreen" ]]; then
    KS_INSTALLED="1"
fi
if [[ "${KS_INSTALLED}" = "1" ]]; then
    SERVICES+=(KlipperScreen)
fi

## Helper funcs
### Mangle services
stop_services() {
    for srv in "${SERVICES[@]}"; do
        if [[ "$(systemctl is-active "${srv}.service")" != "inactive" ]]; then
            systemctl stop "${srv}.service"
        fi
    done
}

### Clean up
cleanup() {
    # Remove first-boot script
    rm -f /opt/crafter3d/firstboot.sh
    # Disable first-boot service
    systemctl disable crafter3d-firstboot.service 2>/dev/null || true
}

### Change nginx root
change_www_root() {
    sed -i "s|/home/${BUILD_USER}/mainsail|/home/${DEFAULT_USER}/mainsail|g" \
        /etc/nginx/sites-available/mainsail
}

### change username in service files
change_service_user() {
    ### Filter nginx service first!
    local -a servicefile
    servicefile=( "${SERVICES[@]/nginx}" )

    for i in "${servicefile[@]}"; do
        if [[ -n "${i}" ]]; then
            sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "${SYSTEMD_DIR}/${i}.service"
        fi
    done
}

change_env_user() {
    local env_files env_path
    env_path="/home/${DEFAULT_USER}/printer_data/systemd"
    if [[ ! -d "${env_path}" ]]; then
        return
    fi
    env_files="$(find "${env_path}" -type f -name "*.env" -printf "%f ")"
    for ef in ${env_files}; do
        sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "${env_path}/${ef}"
    done
}

relocate_home() {
    if [[ "${DEFAULT_USER}" == "${BUILD_USER}" ]]; then
        return
    fi

    if [[ -d "/home/${BUILD_USER}" ]]; then
        echo -e "${WHITE}Relocating files from /home/${BUILD_USER} to /home/${DEFAULT_USER} ...${NOC}"
        install -d -m 755 -o "${DEFAULT_USER}" -g "${DEFAULT_USER}" "/home/${DEFAULT_USER}"
        cp -a "/home/${BUILD_USER}/." "/home/${DEFAULT_USER}/"
        chown -R "${DEFAULT_USER}:${DEFAULT_USER}" "/home/${DEFAULT_USER}"
    fi
}

fix_absolute_symlinks() {
    local link target new_target

    if [[ "${DEFAULT_USER}" == "${BUILD_USER}" ]]; then
        return
    fi

    while IFS= read -r -d '' link; do
        target="$(readlink "${link}")"
        if [[ "${target}" == "/home/${BUILD_USER}/"* ]]; then
            new_target="/home/${DEFAULT_USER}/${target#/home/${BUILD_USER}/}"
            ln -sfn "${new_target}" "${link}"
        fi
    done < <(find "/home/${DEFAULT_USER}" -type l -print0 2>/dev/null)
}

remove_build_user() {
    if [[ "${DEFAULT_USER}" == "${BUILD_USER}" ]]; then
        return
    fi

    if id -u "${BUILD_USER}" &> /dev/null; then
        userdel -r "${BUILD_USER}" 2>/dev/null || true
        if id -u "${BUILD_USER}" &> /dev/null; then
            userdel "${BUILD_USER}" 2>/dev/null || true
            rm -rf "/home/${BUILD_USER}" 2>/dev/null || true
        fi
    fi
}

relocate_venv() {
    local -a venvs
    local venv_path
    venvs=(klippy-env moonraker-env)

    ### KlipperScreen workaround
    if [[ "${KS_INSTALLED}" = "1" ]]; then
        venvs+=(.KlipperScreen-env)
    fi

    for venv in "${venvs[@]}"; do
        venv_path="/home/${DEFAULT_USER}/${venv}"
        if [[ ! -d "${venv_path}" ]]; then
            continue
        fi

        # Move venv
        # delete pycache (*.pyc files)
        find "${venv_path}" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null

        # repair shebangs
        while IFS= read -r file ; do
            sed -i "s|${BUILD_USER}/${venv}|${DEFAULT_USER}/${venv}|g" "${file}"
        done < <(grep -iR "${BUILD_USER}/${venv}" "${venv_path}"/* 2>/dev/null | cut -d":" -f1 || true)
    done
}

patch_polkit_rules() {
    local polkit_dir polkit_legacy_dir polkit_usr_dir
    polkit_legacy_dir="/etc/polkit-1/localauthority/50-local.d"
    polkit_dir="/etc/polkit-1/rules.d"
    polkit_usr_dir="/usr/share/polkit-1/rules.d"
    if [[ -f "${polkit_dir}/moonraker.rules" ]]; then
        sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "${polkit_dir}/moonraker.rules"
    fi
    if [[ -f "${polkit_usr_dir}/moonraker.rules" ]]; then
        sed -i "s|\"${BUILD_USER}\"|\"${DEFAULT_USER}\"|g" "${polkit_usr_dir}/moonraker.rules"
    fi
    if [[ -f "${polkit_legacy_dir}/10-moonraker.pkla" ]]; then
        sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "${polkit_legacy_dir}/10-moonraker.pkla"
    fi
    if [[ -f "${polkit_dir}/KlipperScreen.rules" ]]; then
        sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "${polkit_dir}/KlipperScreen.rules"
    fi
    if [[ -f "${polkit_usr_dir}/KlipperScreen.rules" ]]; then
        sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "${polkit_usr_dir}/KlipperScreen.rules"
    fi
    if [[ -f "${polkit_legacy_dir}/20-klipperscreen.pkla" ]]; then
        sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "${polkit_legacy_dir}/20-klipperscreen.pkla"
    fi
}

patch_cn_logpath() {
    local cn_cfg
    cn_cfg="/home/${DEFAULT_USER}/printer_data/config/crowsnest.conf"
    if [[ -f "${cn_cfg}" ]]; then
        sed -i "s|/home/${BUILD_USER}/printer_data/logs/crowsnest.log|/home/${DEFAULT_USER}/printer_data/logs/crowsnest.log|g" \
            "${cn_cfg}"
    fi
}

patch_cn_logrotate() {
    if [[ -f "/etc/logrotate.d/crowsnest" ]]; then
        sed -i "s|${BUILD_USER}|${DEFAULT_USER}|g" "/etc/logrotate.d/crowsnest"
    fi
}

ensure_cn_runtime_files() {
    local config_dir logs_dir cn_cfg cn_tpl log_file
    config_dir="/home/${DEFAULT_USER}/printer_data/config"
    logs_dir="/home/${DEFAULT_USER}/printer_data/logs"
    cn_cfg="${config_dir}/crowsnest.conf"
    cn_tpl="/home/${DEFAULT_USER}/crowsnest/config/crowsnest.conf"
    log_file="${logs_dir}/crowsnest.log"

    install -d -m 755 -o "${DEFAULT_USER}" -g "${DEFAULT_USER}" "${config_dir}" "${logs_dir}"

    if [[ ! -f "${cn_cfg}" ]] && [[ -f "${cn_tpl}" ]]; then
        cp "${cn_tpl}" "${cn_cfg}"
        chown "${DEFAULT_USER}:${DEFAULT_USER}" "${cn_cfg}"
    fi

    if [[ -f "${cn_cfg}" ]]; then
        if grep -qE '^[[:space:]]*log_path[[:space:]]*:' "${cn_cfg}"; then
            sed -i "s|^[[:space:]]*log_path[[:space:]]*:.*$|log_path: ${log_file}|g" "${cn_cfg}"
        elif grep -qE '^\[crowsnest\]' "${cn_cfg}"; then
            sed -i "/^\[crowsnest\]/a log_path: ${log_file}" "${cn_cfg}"
        fi
    fi

    touch "${log_file}"
    chown "${DEFAULT_USER}:${DEFAULT_USER}" "${log_file}"
}

patch_unresolved_baseuser_placeholders() {
    local ngf service_file env_file
    ngf="/etc/nginx/sites-available/mainsail"

    if [[ -f "${ngf}" ]]; then
        sed -i 's|${BASE_USER}|'"${DEFAULT_USER}"'|g' "${ngf}"
    fi

    if [[ -f "${SYSTEMD_DIR}/klipper.service" ]]; then
        sed -i 's|${BASE_USER}|'"${DEFAULT_USER}"'|g' "${SYSTEMD_DIR}/klipper.service"
    fi

    if [[ -f "${SYSTEMD_DIR}/moonraker.service" ]]; then
        sed -i 's|${BASE_USER}|'"${DEFAULT_USER}"'|g' "${SYSTEMD_DIR}/moonraker.service"
    fi

    if [[ -f "/home/${DEFAULT_USER}/printer_data/systemd/klipper.env" ]]; then
        sed -i 's|${BASE_USER}|'"${DEFAULT_USER}"'|g' "/home/${DEFAULT_USER}/printer_data/systemd/klipper.env"
    fi

    if [[ -f "/home/${DEFAULT_USER}/printer_data/systemd/moonraker.env" ]]; then
        sed -i 's|${BASE_USER}|'"${DEFAULT_USER}"'|g' "/home/${DEFAULT_USER}/printer_data/systemd/moonraker.env"
    fi

    # Normalize all managed service files: fix stale /home/pi, /home/${BUILD_USER},
    # unresolved ${BASE_USER} placeholders, and force the correct User= line.
    for service_file in \
        "${SYSTEMD_DIR}/klipper.service" \
        "${SYSTEMD_DIR}/moonraker.service" \
        "${SYSTEMD_DIR}/crowsnest.service" \
        "${SYSTEMD_DIR}/sonar.service" \
        "${SYSTEMD_DIR}/KlipperScreen.service"; do
        if [[ -f "${service_file}" ]]; then
            sed -i "s|/home/pi/|/home/${DEFAULT_USER}/|g" "${service_file}"
            sed -i "s|/home/${BUILD_USER}/|/home/${DEFAULT_USER}/|g" "${service_file}"
            sed -i 's|${BASE_USER}|'"${DEFAULT_USER}"'|g' "${service_file}"
            sed -i "s|^User=.*$|User=${DEFAULT_USER}|" "${service_file}"
            sed -i "s|^WorkingDirectory=/home/pi/|WorkingDirectory=/home/${DEFAULT_USER}/|g" "${service_file}"

            # KlipperScreen-specific: fix PAMName and BACKEND
            if [[ "${service_file}" == *"KlipperScreen"* ]]; then
                sed -i "s|^PAMName=.*$|PAMName=${DEFAULT_USER}|" "${service_file}"
                sed -i 's|BACKEND=X|BACKEND=cage|g' "${service_file}"
            fi
        fi
    done

    # Normalize all managed environment files.
    local env_search_dirs=(
        "/home/${DEFAULT_USER}/printer_data/systemd"
        "/home/${BUILD_USER}/printer_data/systemd"
        "/home/pi/printer_data/systemd"
    )
    for env_dir in "${env_search_dirs[@]}"; do
        if [[ -d "${env_dir}" ]]; then
            while IFS= read -r -d '' env_file; do
                sed -i "s|/home/pi/|/home/${DEFAULT_USER}/|g" "${env_file}"
                sed -i "s|/home/${BUILD_USER}/|/home/${DEFAULT_USER}/|g" "${env_file}"
                sed -i 's|${BASE_USER}|'"${DEFAULT_USER}"'|g' "${env_file}"
            done < <(find "${env_dir}" -maxdepth 1 -name '*.env' -print0 2>/dev/null)
        fi
    done
}

## Fix broken links
fix_broken_links() {
    local -a brokenlinks
    local path
    brokenlinks=(crowsnest sonar)
    path="/usr/local/bin"

    for bl in "${brokenlinks[@]}"; do
        if [[ -h "${path}/${bl}" ]]; then
            rm -rf "${path:?}/${bl}"
        fi
        find "/home/${DEFAULT_USER}" -type f -iname "${bl}" -print0 | \
        xargs -0 -I {} ln -s {} "${path}/${bl}"
    done
}

fix_timelapse_links() {
    local config_dir src_dir target_dir moonraker_gitignore gitignore_entry
    config_dir="/home/${DEFAULT_USER}/printer_data/config"
    src_dir="/home/${DEFAULT_USER}/moonraker-timelapse"
    target_dir="/home/${DEFAULT_USER}/moonraker/moonraker/components"
    moonraker_gitignore="/home/${DEFAULT_USER}/moonraker/.gitignore"
    gitignore_entry="moonraker/components/timelapse.py"
    if [[ -f "${src_dir}/component/timelapse.py" ]] && [[ -d "${target_dir}" ]]; then
        sudo -u "${DEFAULT_USER}" \
        ln -sf "${src_dir}/component/timelapse.py" "${target_dir}/timelapse.py"
    fi
    if [[ -f "${src_dir}/klipper_macro/timelapse.cfg" ]] && [[ -d "${config_dir}" ]]; then
        sudo -u "${DEFAULT_USER}" \
        ln -sf "${src_dir}/klipper_macro/timelapse.cfg" "${config_dir}/timelapse.cfg"
    fi
    if [[ -d "/home/${DEFAULT_USER}/moonraker/.git" ]]; then
        if ! sudo -u "${DEFAULT_USER}" grep -Fxq "${gitignore_entry}" "${moonraker_gitignore}" 2>/dev/null; then
            echo "${gitignore_entry}" | sudo -u "${DEFAULT_USER}" tee -a "${moonraker_gitignore}" > /dev/null
        fi
    fi
}

fix_mainsailcfg_links() {
    local config_dir src_dir install_script
    config_dir="/home/${DEFAULT_USER}/printer_data/config"
    src_dir="/home/${DEFAULT_USER}/mainsail-config"
    install_script="${src_dir}/scripts/install.sh"
    if [[ -f "${install_script}" ]]; then
        sudo -u "${DEFAULT_USER}" HOME="/home/${DEFAULT_USER}" bash "${install_script}"
    elif [[ -f "${src_dir}/mainsail.cfg" ]] && [[ -d "${config_dir}" ]]; then
        # Fallback for older mainsail-config trees without an installer script.
        sudo -u "${DEFAULT_USER}" \
        install -m 0644 "${src_dir}/mainsail.cfg" "${config_dir}/mainsail.cfg"
    fi
}

# Optional if kiauh module is used
fix_kiauh_links() {
    local src_dir target_dir
    src_dir="/home/${DEFAULT_USER}/kiauh"
    target_dir="/usr/local/bin"
    ln -sf "${src_dir}/kiauh.sh" "${target_dir}/kiauh"
}

fix_cn_links() {
    local tools_dir
    tools_dir="/home/${DEFAULT_USER}/crowsnest/tools"
    if [[ -f "${tools_dir}/libs/pkglist-rpi.sh" ]]; then
        sudo -u "${DEFAULT_USER}" \
        ln -sf "${tools_dir}/libs/pkglist-rpi.sh" "${tools_dir}/pkglist.sh"
    fi
}

refresh_printer_config_links() {
    local install_script
    install_script="/home/${DEFAULT_USER}/printer-config/scripts/install.sh"
    if [[ -f "${install_script}" ]]; then
        sudo -u "${DEFAULT_USER}" HOME="/home/${DEFAULT_USER}" bash "${install_script}"
    fi
}

main() {
local cmdltxt
cmdltxt="/boot/firmware/cmdline.txt"
if [[ ! -f "${cmdltxt}" ]]; then
    cmdltxt="/boot/cmdline.txt"
fi

exec &> >(tee -a /var/log/postrename.log)

## Make sure init_resize.sh and firstrun.sh are finished
## grep returns exit 1 on no match; protect against set -e
local init_count systemd_count
init_count="$(grep -c 'init=' "${cmdltxt}" 2>/dev/null || true)"
systemd_count="$(grep -c 'systemd\.run' "${cmdltxt}" 2>/dev/null || true)"
if [[ "${init_count}" != "0" ]] && [[ "${systemd_count}" != "0" ]]; then
    echo -e "[${RED}ERROR${NOC}] \
    ${WHITE}Sdcard resize and firstrun are not finished yet ... [ABORT]${NOC}"
    ## Do not fail firstboot service
    return 0
fi
## Abort if user = build user (default; already set up for this user)
if [[ "${DEFAULT_USER}" == "${BUILD_USER}" ]]; then
    patch_unresolved_baseuser_placeholders
    ensure_cn_runtime_files
    systemctl daemon-reload
    echo -e "[${YEL}SKIPPED${NOC}] \
    ${WHITE}User is ${DEFAULT_USER}! Nothing to do ...${NOC}"
    cleanup
    exit 0
fi

echo -e "\n\t${WHITE}Trying to fix user rename ...${NOC}"
## Relocate home content before patching services and envs.
echo -en "${WHITE}Relocating user home content ...${NOC}\r"
relocate_home
fix_absolute_symlinks
echo -e "${WHITE}Relocating user home content ...${NOC}[${GRE}OK${NOC}]"
## Stop services
echo -en "${WHITE}Stopping all related services ...${NOC}\r"
stop_services
echo -e "${WHITE}Stopping all related services ...${NOC}[${GRE}OK${NOC}]"
## Change www root
echo -en "${WHITE}Try changing path of nginx root ...${NOC}\r"
change_www_root
echo -e "${WHITE}Try changing path of nginx root ...${NOC}[${GRE}OK${NOC}]"
## patch service files
echo -en "${WHITE}Patching service files ...${NOC}\r"
change_service_user
echo -e "${WHITE}Patching service files ...${NOC}[${GRE}OK${NOC}]"
## patch env files
echo -en "${WHITE}Patching environment files ...${NOC}\r"
change_env_user
echo -e "${WHITE}Patching environment files ...${NOC}[${GRE}OK${NOC}]"
## relocate venvs
echo -e "${WHITE}Trying to relocate venv's ...${NOC}"
relocate_venv
echo -e "${WHITE}Trying to relocate venv's ...${NOC}[${GRE}OK${NOC}]"
## patch polkit rules
echo -e "${WHITE}Patching moonraker's polkit rules ...${NOC}"
patch_polkit_rules
echo -e "${WHITE}Patching moonraker's polkit rules ...${NOC}[${GRE}OK${NOC}]"
## patch crownsnest log path
echo -en "${WHITE}Patching crowsnest logpath ...${NOC}\r"
patch_cn_logpath
echo -e "${WHITE}Patching crowsnest logpath ...${NOC}[${GRE}OK${NOC}]"
## patch crowsnest logrotate
echo -e "${WHITE}Patching crowsnest logrotate ...${NOC}"
patch_cn_logrotate
echo -e "${WHITE}Patching crowsnest logrotate ...${NOC}[${GRE}OK${NOC}]"
## ensure crowsnest runtime files
echo -en "${WHITE}Ensuring crowsnest runtime files ...${NOC}\r"
ensure_cn_runtime_files
echo -e "${WHITE}Ensuring crowsnest runtime files ...${NOC}[${GRE}OK${NOC}]"
## patch unresolved BASE_USER placeholders
echo -en "${WHITE}Patching unresolved BASE_USER placeholders ...${NOC}\r"
patch_unresolved_baseuser_placeholders
echo -e "${WHITE}Patching unresolved BASE_USER placeholders ...${NOC}[${GRE}OK${NOC}]"
## fix broken links and refresh copied configs
echo -en "${WHITE}Fix runtime links and refresh configs ...${NOC}\r"
fix_broken_links
fix_timelapse_links
fix_mainsailcfg_links
refresh_printer_config_links
# Optional if kiauh module is used
if [[ -d "/home/${DEFAULT_USER}/kiauh" ]]; then
    fix_kiauh_links
fi
fix_cn_links
echo -e "${WHITE}Fix runtime links and refresh configs ...${NOC}[${GRE}OK${NOC}]"
## reload daemons
echo -en "${WHITE}Apply service file changes ...${NOC}\r"
systemctl daemon-reload
echo -e "${WHITE}Apply service file changes ...${NOC}[${GRE}OK${NOC}]"
## enable KlipperScreen persistently if installed (without --now)
if [[ "${KS_INSTALLED}" = "1" ]]; then
    echo -en "${WHITE}Enabling KlipperScreen service ...${NOC}\r"
    systemctl enable KlipperScreen.service || true
    echo -e "${WHITE}Enabling KlipperScreen service ...${NOC}[${GRE}OK${NOC}]"
fi
## remove stale build user after successful migration
echo -en "${WHITE}Removing stale build user ...${NOC}\r"
remove_build_user
echo -e "${WHITE}Removing stale build user ...${NOC}[${GRE}OK${NOC}]"
## Cleanup
echo -e "${WHITE}Cleanup files, remove firstboot ...${NOC}"
cleanup
## reboot system
echo -e "${WHITE}Reboot system ...${NOC}"
reboot
}

### MAIN
main
exit 0
