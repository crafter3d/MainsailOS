#!/bin/bash
#### Crafter3D First-Boot Setup Wizard
####
#### Runs on tty1 after a raw (non-customised) flash.
#### Asks the user whether to enable SSH and KlipperScreen,
#### then removes itself so it never runs again.
####
#### This File is distributed under GPLv3

set -Ee
export LC_ALL=C

# Colored Output
RED="\e[31m"
GRE="\e[32m"
WHITE="\e[97m"
NOC="\e[0m"

MARKER="/home/crafter3d/.crafter3d_firstboot_needed"
KS_DIR="/home/crafter3d/KlipperScreen"

########################################
# Guard: only run on raw-flash boots   #
########################################

# If the marker was already removed (Pi Imager customized boot or a
# re-run after the wizard completed), exit silently.
if [[ ! -f "${MARKER}" ]]; then
    exit 0
fi

########################################
# Wait for a usable tty                #
########################################

# Give the console a moment to settle after boot
sleep 2

########################################
# Helper: draw a header               #
########################################

show_header() {
    clear
    echo -e "${WHITE}"
    echo "  ╔══════════════════════════════════════════════╗"
    echo "  ║         Crafter3D — First Boot Setup         ║"
    echo "  ╚══════════════════════════════════════════════╝"
    echo -e "${NOC}"
}

########################################
# SSH                                  #
########################################

configure_ssh() {
    show_header
    if whiptail \
        --title "SSH Access" \
        --yesno "Enable SSH remote access?\n\nThis lets you connect to the printer from another computer." \
        10 60 \
        --defaultno 3>&1 1>&2 2>&3; then
        raspi-config nonint do_ssh 0
        echo -e "${GRE}  SSH enabled.${NOC}"
    else
        raspi-config nonint do_ssh 1
        echo -e "${WHITE}  SSH left disabled.${NOC}"
    fi
    sleep 1
}

########################################
# KlipperScreen                        #
########################################

configure_klipperscreen() {
    # Only offer KlipperScreen if it was installed at build time
    if [[ ! -d "${KS_DIR}" ]]; then
        return 0
    fi

    show_header
    if whiptail \
        --title "KlipperScreen" \
        --yesno "Enable KlipperScreen touchscreen UI?\n\nRequires a display connected to the Raspberry Pi.\nYou can enable it later with:\n  sudo systemctl enable --now KlipperScreen.service" \
        13 66 \
        --defaultno 3>&1 1>&2 2>&3; then
        systemctl enable --now KlipperScreen.service || true
        echo -e "${GRE}  KlipperScreen enabled.${NOC}"
    else
        echo -e "${WHITE}  KlipperScreen left disabled.${NOC}"
    fi
    sleep 1
}

########################################
# Summary                              #
########################################

show_summary() {
    local ssh_state ks_state
    ssh_state="$(systemctl is-enabled ssh 2>/dev/null || echo disabled)"
    if [[ -d "${KS_DIR}" ]]; then
        ks_state="$(systemctl is-enabled KlipperScreen 2>/dev/null || echo disabled)"
    else
        ks_state="not installed"
    fi

    show_header
    whiptail \
        --title "Setup Complete" \
        --msgbox "\
Configuration applied:

  SSH:            ${ssh_state}
  KlipperScreen:  ${ks_state}

Access Mainsail at:  http://crafter3d.local
SSH login:           ssh crafter3d@crafter3d.local

Press Enter to finish." \
        16 60 \
        3>&1 1>&2 2>&3 || true
}

########################################
# Main                                 #
########################################

main() {
    configure_ssh
    configure_klipperscreen
    show_summary

    # Remove marker — wizard must not run again
    rm -f "${MARKER}"

    # Disable the service unit (self-disabling one-shot)
    systemctl disable crafter3d-firstboot.service || true

    clear
    echo -e "\n${GRE}  Crafter3D setup complete. Enjoy printing!${NOC}\n"
}

main
exit 0
