#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

source /common.sh
install_cleanup_trap
source /files/00-config

########################################
# Configuration                        #
########################################

BTWIFISET_DIR="/usr/local/btwifiset"
BTWIFISET_BASE_URL="https://raw.githubusercontent.com/nksan/Rpi-SetWiFi-viaBluetooth/main"
BTWIFISET_FILES=(btwifiset.py btpassword.py passwordREADME.txt)

DEPS=(
    wget
    ca-certificates
    bluez
    rfkill
    python3-gi
    libdbus-glib-1-dev
    python3-dbus
    python3-cryptography
)

apt-get install --yes "${DEPS[@]}"

########################################
# Install btwifiset files              #
########################################

mkdir -p "${BTWIFISET_DIR}"

for f in "${BTWIFISET_FILES[@]}"; do
    wget -qO "${BTWIFISET_DIR}/${f}" "${BTWIFISET_BASE_URL}/${f}"
    if [[ "${f}" == *.txt ]]; then
        chmod 644 "${BTWIFISET_DIR}/${f}"
    else
        chmod 755 "${BTWIFISET_DIR}/${f}"
    fi
done

# Normalize upstream btwifiset BLE local name handling for app compatibility.
if grep -q 'return result.stdout' "${BTWIFISET_DIR}/btwifiset.py"; then
    sed -i 's/return result.stdout/return result.stdout.strip()/' "${BTWIFISET_DIR}/btwifiset.py"
fi

if grep -q 'self.properties\["LocalName"\] = dbus.String(self.hostname)' "${BTWIFISET_DIR}/btwifiset.py"; then
    sed -i 's/self.properties\["LocalName"\] = dbus.String(self.hostname)/self.properties["LocalName"] = dbus.String((self.hostname or "crafter3d").strip())/' "${BTWIFISET_DIR}/btwifiset.py"
fi

########################################
# BlueZ main.conf                     #
########################################

# Experimental mode is required for BLE advertising used by btwifiset.
# Name sets the adapter friendly name. The remaining settings ensure the
# adapter stays discoverable and pairable without timeout.
for setting in \
    'Experimental = true' \
    'Name = crafter3d' \
    'ReverseServiceDiscovery = false' \
    'Privacy = off' \
    'DiscoverableTimeout = 0' \
    'PairableTimeout = 0'
do
    key="${setting%% =*}"
    if grep -qE "^\s*#?\s*${key}\s*=" /etc/bluetooth/main.conf; then
        sed -i -E "/^\s*#?\s*${key}\s*=/c\\${setting}" /etc/bluetooth/main.conf
    else
        sed -i "/^\[General\]/a\\${setting}" /etc/bluetooth/main.conf
    fi
done

########################################
# Install btwifiset service + helpers  #
########################################

# Remove any stale drop-ins from previous versions.
rm -rf /etc/systemd/system/bluetooth.service.d

cp /files/btberrywifi/check-no-internet /usr/local/bin/check-no-internet
cp /files/btberrywifi/prepare-bt-adapter /usr/local/bin/prepare-bt-adapter
cp /files/btberrywifi/btwifiset.service /etc/systemd/system/btwifiset.service
chmod 755 /usr/local/bin/check-no-internet
chmod 755 /usr/local/bin/prepare-bt-adapter

systemctl_if_exists daemon-reload
systemctl_if_exists enable bluetooth
systemctl_if_exists enable hciuart
systemctl_if_exists enable btwifiset
