#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

source /common.sh
install_cleanup_trap
source /files/00-config

########################################
# Configuration                        #
########################################

THEME_DIR="/usr/share/plymouth/themes/crafter3d"

########################################
# Install Plymouth                     #
########################################

echo "Installing Plymouth"
apt-get install --yes plymouth plymouth-themes

########################################
# Deploy Crafter3D theme               #
########################################

echo "Deploying Crafter3D Plymouth theme"
mkdir -p "${THEME_DIR}"
cp /files/splash/crafter3d.plymouth "${THEME_DIR}/"
cp /files/splash/crafter3d.script   "${THEME_DIR}/"
cp /files/splash/logo.png          "${THEME_DIR}/"
cp /files/splash/spinner-*.png     "${THEME_DIR}/"

########################################
# Ensure DRM modules in initramfs      #
########################################

for mod in drm vc4 v3d; do
    if ! grep -qx "${mod}" /etc/initramfs-tools/modules 2>/dev/null; then
        echo "${mod}" >> /etc/initramfs-tools/modules
    fi
done

########################################
# Explicit Plymouth daemon config       #
########################################

cat > /etc/plymouth/plymouthd.conf << 'EOF'
[Daemon]
Theme=crafter3d
ShowDelay=0
DeviceTimeout=8
EOF

########################################
# Set as default Plymouth theme and    #
# rebuild initramfs to embed Plymouth  #
########################################

echo "Setting Crafter3D as default Plymouth theme"
if ! plymouth-set-default-theme crafter3d -R; then
    echo "Crafter3D theme activation failed, falling back to spinner"
    plymouth-set-default-theme spinner -R
fi

########################################
# Adjust firmware display setup        #
########################################

# Raspberry Pi firmware should initialize display for KMS
sed -i '/^disable_fw_kms_setup=1$/d' "${BOOT_PATH}/config.txt"

# auto_initramfs=1 in Bookworm handles initramfs naming automatically
sed -i '/^initramfs[[:space:]].*/d' "${BOOT_PATH}/config.txt"

########################################
# Configure kernel cmdline for splash  #
########################################

# quiet      - suppress kernel log messages on screen
# splash     - activate Plymouth
# plymouth.ignore-serial-consoles - keep splash even when UART is enabled
# logo.nologo - hide the kernel's default Raspberry Pi logo
if ! grep -q "splash" "${BOOT_PATH}/cmdline.txt"; then
    echo "Adding splash parameters to cmdline.txt"
    sed -i 's/$/ quiet splash plymouth.ignore-serial-consoles logo.nologo/' \
        "${BOOT_PATH}/cmdline.txt"
fi

sed -i 's/[[:space:]]video=HDMI-A-1:[^[:space:]]*//g' "${BOOT_PATH}/cmdline.txt"

if ! grep -q 'video=HDMI-A-1:800x480M@60' "${BOOT_PATH}/cmdline.txt"; then
    echo "Adding HDMI timing override for 800x480 display"
    sed -i 's/$/ video=HDMI-A-1:800x480M@60/' "${BOOT_PATH}/cmdline.txt"
fi

########################################
# Ensure Plymouth quits during boot    #
########################################

# plymouth-quit-wait.service is "static" (no [Install] section).
# On desktop images, display-manager.service pulls it in. We have no display
# manager, so we wire it into multi-user.target explicitly.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /lib/systemd/system/plymouth-quit-wait.service \
    /etc/systemd/system/multi-user.target.wants/plymouth-quit-wait.service
ln -sf /lib/systemd/system/plymouth-quit.service \
    /etc/systemd/system/multi-user.target.wants/plymouth-quit.service
